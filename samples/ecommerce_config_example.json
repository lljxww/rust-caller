{
  "文档说明": "电商 API 配置示例，包含常用的电商接口",
  "authorizations": [
    {
      "name": "ShopifyAuth",
      "header_name": "X-Shopify-Access-Token",
      "type": "Header",
      "value": "${SHOPIFY_API_TOKEN}"
    },
    {
      "name": "AlipayAuth",
      "header_name": "Authorization",
      "type": "Bearer",
      "token": "${ALIPAY_API_TOKEN}"
    },
    {
      "name": "WeChatAuth",
      "header_name": "Authorization",
      "type": "Bearer",
      "token": "${WECHAT_API_TOKEN}"
    },
    {
      "name": "JDAuth",
      "header_name": "Authorization",
      "type": "Bearer",
      "token": "${JD_API_TOKEN}"
    }
  ],
  "service_items": [
    {
      "api_name": "Shopify_API",
      "base_url": "https://{shop}.myshopify.com/admin/api/2024-01",
      "description": "Shopify 商店管理 API",
      "api_items": [
        {
          "method": "get_products",
          "url": "/products.json",
          "http_method": "GET",
          "param_type": "query",
          "description": "获取产品列表",
          "timeout": 10000,
          "authorization_type": "ShopifyAuth",
          "query_params": [
            {
              "param_name": "limit",
              "default_value": "50",
              "description": "每页产品数量"
            },
            {
              "param_name": "status",
              "default_value": "active",
              "description": "产品状态：active，draft"
            }
          ]
        },
        {
          "method": "get_product",
          "url": "/products/{product_id}.json",
          "http_method": "GET",
          "param_type": "path",
          "description": "获取特定产品",
          "timeout": 8000,
          "authorization_type": "ShopifyAuth"
        },
        {
          "method": "create_product",
          "url": "/products.json",
          "http_method": "POST",
          "param_type": "json",
          "description": "创建新产品",
          "content_type": "application/json",
          "timeout": 15000,
          "authorization_type": "ShopifyAuth"
        },
        {
          "method": "update_product",
          "url": "/products/{product_id}.json",
          "http_method": "PUT",
          "param_type": "path,json",
          "description": "更新产品信息",
          "content_type": "application/json",
          "timeout": 15000,
          "authorization_type": "ShopifyAuth"
        },
        {
          "method": "get_orders",
          "url": "/orders.json",
          "http_method": "GET",
          "param_type": "query",
          "description": "获取订单列表",
          "timeout": 12000,
          "authorization_type": "ShopifyAuth",
          "query_params": [
            {
              "param_name": "status",
              "default_value": "any",
              "description": "订单状态：any, open, closed, cancelled"
            },
            {
              "param_name": "financial_status",
              "default_value": "paid",
              "description": "支付状态：pending, authorized, partially_paid, paid, refunded"
            }
          ]
        }
      ]
    },

    {
      "api_name": "Alipay_Payment",
      "base_url": "https://openapi.alipay.com/gateway.do",
      "description": "支付宝支付 API",
      "timeout": 15000,
      "api_items": [
        {
          "method": "trade_query",
          "url": "",
          "http_method": "GET",
          "param_type": "query",
          "description": "交易查询接口",
          "timeout": 10000,
          "authorization_type": "AlipayAuth",
          "query_params": [
            {
              "param_name": "app_id",
              "required": true,
              "description": "应用ID"
            },
            {
              "param_name": "method",
              "required": true,
              "description": "接口方法名"
            },
            {
              "param_name": "format",
              "default_value": "JSON",
              "description": "返回格式"
            }
          ]
        },
        {
          "method": "create_trade",
          "url": "",
          "http_method": "POST",
          "param_type": "query",
          "description": "创建统一收单交易并支付接口",
          "timeout": 20000,
          "content_type": "application/x-www-form-urlencoded",
          "authorization_type": "AlipayAuth"
        }
      ]
    },

    {
      "api_name": "WeChat_Payment",
      "base_url": "https://api.mch.weixin.qq.com",
      "description": "微信支付 API",
      "timeout": 30000,
      "api_items": [
        {
          "method": "create_native_trade",
          "url": "/pay/unifiedorder",
          "http_method": "POST",
          "param_type": "json",
          "description": "统一下单接口",
          "timeout": 20000,
          "content_type": "application/xml",
          "authorization_type": "WeChatAuth"
        },
        {
          "method": "query_order",
          "url": "/pay/orderquery",
          "http_method": "POST",
          "param_type": "json",
          "description": "微信支付结果查询",
          "timeout": 15000,
          "content_type": "application/xml",
          "authorization_type": "WeChatAuth"
        },
        {
          "method": "close_order",
          "url": "/pay/closeorder",
          "http_method": "POST",
          "param_type": "json",
          "description": "关闭订单接口",
          "content_type": "application/xml",
          "authorization_type": "WeChatAuth"
        }
      ]
    },

    {
      "api_name": "JD_Product_Search",
      "base_url": "https://api.jd.com/routerjson",
      "description": "京东商品搜索 API",
      "timeout": 10000,
      "api_items": [
        {
          "method": "Search_Items",
          "url": "",
          "http_method": "POST",
          "param_type": "json",
          "description": "获取商品搜索结果",
          "timeout": 15000,
          "content_type": "application/x-www-form-urlencoded",
          "authorization_type": "JDAuth",
          "query_params": [
            {
              "param_name": "keyword",
              "required": true,
              "description": "搜索关键词"
            },
            {
              "param_name": "page",
              "default_value": "1",
              "description": "页码"
            },
            {
              "param_name": "pageSize",
              "default_value": "20",
              "description": "每页数量"
            }
          ]
        }
      ]
    },

    {
      "api_name": "Inventory_Management",
      "base_url": "https://inventory-api.example.com",
      "description": "库存管理 API",
      "timeout": 8000,
      "api_items": [
        {
          "method": "get_stock",
          "url": "/stock",
          "http_method": "GET",
          "param_type": "query",
          "description": "获取库存信息",
          "timeout": 5000,
          "need_cache": true,
          "cache_time": 300
        },
        {
          "method": "update_stock",
          "url": "/stock/{product_id}",
          "http_method": "PUT",
          "param_type": "path,json",
          "description": "更新库存数量",
          "content_type": "application/json",
          "timeout": 8000
        },
        {
          "method": "low_stock_alerts",
          "url": "/stock/alerts",
          "http_method": "GET",
          "param_type": "query",
          "description": "获取低库存预警",
          "timeout": 5000,
          "need_cache": true,
          "cache_time": 60
        }
      ]
    },

    {
      "api_name": "Shipping_API",
      "base_url": "https://shipping-api.example.com",
      "description": "物流配送 API",
      "timeout": 12000,
      "api_items": [
        {
          "method": "calculate_shipping",
          "url": "/shipping/calculate",
          "http_method": "POST",
          "param_type": "json",
          "description": "计算运费",
          "content_type": "application/json",
          "timeout": 10000
        },
        {
          "method": "create_shipping_order",
          "url": "/shipping/orders",
          "http_method": "POST",
          "param_type": "json",
          "description": "创建物流订单",
          "content_type": "application/json",
          "timeout": 15000
        },
        {
          "method": "track_package",
          "url": "/shipping/track/{tracking_number}",
          "http_method": "GET",
          "param_type": "path",
          "description": "包裹跟踪",
          "timeout": 8000,
          "need_cache": true,
          "cache_time": 900
        }
      ]
    }
  ]
}