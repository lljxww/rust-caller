{
  "authorizations": [
    {
      "name": "BearerAuth",
      "authorization_info": "Bearer your-secret-api-token-here"
    },
    {
      "name": "content_typeAuth",
      "authorization_info": "Content-Type application/json; charset=utf-8"
    },
    {
      "name": "CustomHeaderAuth",
      "authorization_info": "X-Custom-Auth custom-auth-value"
    }
  ],
  "service_items": [
    {
      "api_name": "GitHub_API",
      "base_url": "https://api.github.com",
      "timeout": 10000,
      "api_items": [
        {
          "method": "get_user",
          "url": "/users/{username}",
          "http_method": "GET",
          "param_type": "path"
        },
        {
          "method": "get_user_repos",
          "url": "/users/{username}/repos",
          "http_method": "GET",
          "param_type": "path,query"
        },
        {
          "method": "create_issue",
          "url": "/repos/{owner}/{repo}/issues",
          "http_method": "POST",
          "param_type": "path,json"
        }
      ]
    },
    {
      "api_name": "Weather_API",
      "base_url": "https://api.openweathermap.org/data/2.5",
      "timeout": 5000,
      "api_items": [
        {
          "method": "get_current_weather",
          "url": "/weather",
          "http_method": "GET",
          "param_type": "query"
        }
      ]
    }
  ]
}