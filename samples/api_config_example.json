{
  "Authorizations": [
    {
      "Name": "BearerAuth",
      "AuthorizationInfo": "Bearer your-secret-api-token-here"
    },
    {
      "Name": "ContentTypeAuth",
      "AuthorizationInfo": "Content-Type application/json; charset=utf-8"
    },
    {
      "Name": "CustomHeaderAuth",
      "AuthorizationInfo": "X-Custom-Auth custom-auth-value"
    }
  ],
  "ServiceItems": [
    {
      "ApiName": "GitHub_API",
      "BaseUrl": "https://api.github.com",
      "Timeout": 10000,
      "ApiItems": [
        {
          "Method": "get_user",
          "Url": "/users/{username}",
          "HttpMethod": "GET",
          "ParamType": "path"
        },
        {
          "Method": "get_user_repos",
          "Url": "/users/{username}/repos",
          "HttpMethod": "GET",
          "ParamType": "path,query"
        },
        {
          "Method": "create_issue",
          "Url": "/repos/{owner}/{repo}/issues",
          "HttpMethod": "POST",
          "ParamType": "path,json"
        }
      ]
    },
    {
      "ApiName": "Weather_API",
      "BaseUrl": "https://api.openweathermap.org/data/2.5",
      "Timeout": 5000,
      "ApiItems": [
        {
          "Method": "get_current_weather",
          "Url": "/weather",
          "HttpMethod": "GET",
          "ParamType": "query"
        }
      ]
    }
  ]
}